<?xml version="1.0"?>
<package format="3">
  <name>cypher_robot_mind</name><version>0.2.0</version>
  <description>A virtual robot with Bayesian mapping, Kalman tracking, hierarchical relaxation labeling and observable attention.</description>
  <maintainer email="rmichaelglover@users.noreply.github.com">R. Michael Glover</maintainer>
  <license>MIRL-1.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>python3-chess</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend><exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
