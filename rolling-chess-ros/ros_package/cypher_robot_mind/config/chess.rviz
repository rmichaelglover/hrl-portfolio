Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 22; 33; 43
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 12
    - Class: rviz_default_plugins/MarkerArray
      Name: Wooden chess apparatus
      Enabled: true
      Topic:
        Value: /rolling_chess/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: Board axes
      Enabled: true
      Show Names: true
      Show Axes: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.65
      Pitch: 0.8
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.25
